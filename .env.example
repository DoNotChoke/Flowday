# Copy to .env. Use the Neon dev branch, never production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Without a key, mail is printed to the console in development and fails in production.
# The free onboarding@resend.dev sender only reaches the email of your Resend account.
RESEND_API_KEY=
# Comma-separated. Anyone else is refused at sign-up; an empty list refuses everyone.
# The e2e addresses are for npm run test:e2e. Never add them in production.
ALLOWED_EMAILS=you@example.com,e2e-desktop@flowday.test,e2e-mobile@flowday.test,e2e-shell-desktop@flowday.test,e2e-shell-mobile@flowday.test
